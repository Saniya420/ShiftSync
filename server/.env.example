DATABASE_URL=postgresql://shiftsync@localhost:5433/shiftsync
TEST_DATABASE_URL=postgresql://shiftsync@localhost:5433/shiftsync_test
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PORT=3001
API_PORT=3001
NODE_ENV=development

# Optional integrations. Leave blank for deterministic scheduling + logged emails.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
RESEND_API_KEY=
SMTP_URL=
EMAIL_FROM=ShiftSync <notifications@shiftsync.local>
